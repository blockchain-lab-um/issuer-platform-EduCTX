    "@nextui-org/react": "2.6.11",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@react-email/components": "0.0.23",
    "@react-email/render": "1.4.0",
    "@tanstack/react-query": "5.62.10",
    "@types/node": "^20.14.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.19",
